# Socket config
REACT_APP_Mode=Development
REACT_APP_SOCKET_PORT=8080
REACT_APP_SOCKET_URL=http://localhost:8080/

# TURN servers (JSON array of iceServers entries). Loaded by
# src/util/WebRTC-Config.js. If unset/invalid/empty, no TURN is used (STUN only).
# Do NOT put the TURN credential key of your own TURN production server here;
# that must stay server-side. These are public free TURN for testing only.
REACT_APP_TURN_SERVERS='[]'